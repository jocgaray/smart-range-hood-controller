# ==========================================
# API Credentials & External Services
# ==========================================
GEMINI_API_KEY=gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# Service & Runtime Configuration
# ==========================================
# API Endpoint URL
# Use http://api:8000 when running inside Docker Compose
# Use http://localhost:8000 if running Streamlit directly on your local host system
API_URL=http://api:8000
MODEL_PATH=models/event_detector.joblib

# ==========================================
# MLOps & Experiment Tracking
# ==========================================
# Local SQLite database or remote server URI (e.g., http://localhost:5000)
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db  